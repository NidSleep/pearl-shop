# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local.

# Public URL of the site (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only! Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only checkout limiter HMAC secret: use at least 32 random bytes.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Use the same value across instances. Rotation resets the checkout quota.
RATE_LIMIT_SECRET=

# Stripe → Developers → API keys (use test keys sk_test_... while developing)
STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` (local) or Stripe Dashboard → Webhooks (production)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Server-only confirmation email (optional; missing config skips with a warning).
RESEND_API_KEY=
# Use a sender on a verified Resend domain, e.g. Pearl Shop <orders@example.com>
EMAIL_FROM=

# Server-only admin allowlist; comma-separated Supabase Auth user emails.
# Case-insensitive; an empty list denies all admin access.
ADMIN_EMAILS=
